const { chromium } = require('playwright');
(async () => {
  const browser = await chromium.launch({ headless: true });
  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });
  await page.goto('http://127.0.0.1:5173/demo/?tts=0');
  await page.waitForFunction(() => !!window.__clickyTest);
  await page.route('**/ai/chat', route => route.abort('failed'));
  const eventPromise = page.waitForFunction(() => window.__clickyTest.events.some(e => e.eventName === 'cursor:pointing'), null, { timeout: 10000 });
  await page.evaluate(() => { void window.__clicky.sendUserText('find the create invoice button'); });
  await eventPromise;
  const id = await page.evaluate(() => window.__clickyTest.events.find(e => e.eventName === 'cursor:pointing').payload.command.elementId);
  await page.setViewportSize({ width: 800, height: 600 });
  await page.waitForTimeout(1000);
  const data = await page.evaluate((id) => {
    const matches = Array.from(document.querySelectorAll(`[data-clicky-id="${CSS.escape(id)}"]`)).map(el => {
      const r = el.getBoundingClientRect();
      return { tag: el.tagName, text: el.textContent?.trim(), left: r.left, top: r.top, width: r.width, selector: el.id ? `#${el.id}` : el.getAttribute('data-clicky-label') };
    });
    const root = document.querySelector('.clicky-overlay-host').shadowRoot;
    const h = root.querySelector('.clicky-element-highlight').getBoundingClientRect();
    return { id, matches, highlight: { left: h.left, top: h.top, width: h.width }, htmlLeft: document.documentElement.getBoundingClientRect().left, scrollX: window.scrollX, innerWidth: window.innerWidth };
  }, id);
  console.log(JSON.stringify(data, null, 2));
  await browser.close();
})();
