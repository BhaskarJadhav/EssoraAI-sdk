export type ClickyCapturedElement = {
  id: string;
  tagName: string;
  role?: string;
  label: string;
  text: string;
  selector: string;
  bounds: ClickyRect;
  isInteractive: boolean;
};

export type ClickySemanticNode = {
  stableId: string;
  role: string;
  name: string;
